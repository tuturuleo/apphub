{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apphub",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apphub",
      // Для деплоя: `npx wrangler d1 create apphub` и вставить сюда database_id
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Создание ресурсов проекта идёт в фоне и не зависит от того, дождался ли клиент ответа
  "workflows": [
    { "name": "apphub-provision", "binding": "PROVISION", "class_name": "ProvisionWorkflow" }
  ],
  "vars": {
    // Cloudflare Access: домен команды (например, myteam.cloudflareaccess.com) и AUD приложения
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Мониторинг проектов и уведомления в Telegram (только у задеплоенного Worker)
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
